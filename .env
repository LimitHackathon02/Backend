# 환경설정 템플릿. scripts/start.sh가 .env가 없으면 이 파일을 .env로 복사합니다.
# 값을 바꾼 뒤에는 서버를 재시작해야 반영됩니다.

# ── HyperCLOVA X ─────────────────────────────────────────
# true: 외부 호출 없는 모의 실행 / false: 실제 API 호출
MOCK_MODE=true
CLOVA_API_KEY=
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_TEXT_MODEL=HCX-DASH-002
CLOVA_VISION_MODEL=HCX-005
CLOVA_TIMEOUT_SECONDS=60

# ── 저장소 / 작업 설정 ───────────────────────────────────
DATABASE_PATH=data/hackathon.sqlite3
TASKS_PATH=tasks.json
CACHE_TTL_SECONDS=3600

# ── 사용량 제한 (실제 결제 한도를 보장하지 않음) ─────────
MAX_LIVE_CALLS=300
TOKEN_STOP_THRESHOLD=200000

# ── 팀 공유 / CORS ───────────────────────────────────────
# 외부에 서버를 공유할 때 설정하고, 요청마다 X-Team-Key 헤더로 전송
TEAM_API_KEY=
# 쉼표로 구분한 프론트엔드 주소
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 네이버 지역 검색 (NCP > NAVER API HUB > Application) ─
# 구형 개발자센터 키를 쓰면 BASE_URL을 https://openapi.naver.com 으로 변경
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SEARCH_BASE_URL=https://naverapihub.apigw.ntruss.com

# ── NCP Maps (지도 표시, Geocoding, Directions) ──────────
# 없어도 동작하며 이동 시간은 직선거리로 대체됩니다.
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=
NCP_MAPS_BASE_URL=https://maps.apigw.ntruss.com
