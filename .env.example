# 환경설정 템플릿. 이 파일을 .env로 복사한 뒤 값을 채웁니다.
# 값을 바꾸면 서버를 재시작해야 반영됩니다. (--reload는 .env 변경을 감지하지 않음)

# ── 서버 ─────────────────────────────────────────────────
# development | production
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# 쉼표로 구분한 프론트엔드 주소
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 외부에 서버를 공유할 때 설정. 비워 두면 인증 없이 접근 가능
# 설정하면 요청마다 X-Team-Key 헤더로 같은 값을 보내야 함
TEAM_API_KEY=

# ── HyperCLOVA X (CLOVA Studio) ──────────────────────────
# true: 외부 호출 없이 고정 예시 응답 / false: 실제 API 호출
MOCK_MODE=true
CLOVA_API_KEY=
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_TEXT_MODEL=HCX-DASH-002
CLOVA_VISION_MODEL=HCX-005
CLOVA_TIMEOUT_SECONDS=60

# ── 네이버 지역 검색 (NCP 콘솔 > NAVER API HUB > Application) ─
# 구형 개발자센터 키를 쓰면 BASE_URL을 https://openapi.naver.com 으로 변경
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SEARCH_BASE_URL=https://naverapihub.apigw.ntruss.com

# ── NCP Maps (지도 표시, Geocoding, Directions) ──────────
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=
NCP_MAPS_BASE_URL=https://maps.apigw.ntruss.com

# ── 저장소 ───────────────────────────────────────────────
DATABASE_PATH=data/app.sqlite3
