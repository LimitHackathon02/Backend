# app/config.py가 읽는 환경변수. 값을 바꾸면 서버를 재시작하세요.

# 1: 외부 API 호출 없이 예시 응답 / 0: 실제 API 호출
MOCK_MODE=1

# ── HyperCLOVA X (CLOVA Studio) ──
CLOVA_API_KEY=
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com
HCX_MODEL=HCX-007
HCX_LIGHT_MODEL=HCX-DASH-002

# ── 네이버 지역 검색 (developers.naver.com 애플리케이션 키) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── NCP Maps (Directions 등) ──
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
NCP_MAPS_BASE=https://maps.apigw.ntruss.com

# ── 저장소 / CORS ──
DATA_PATH=data/meetings.json
# 쉼표로 구분. *는 모두 허용
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
